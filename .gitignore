# Build outputs
bin/
build/
target/
node_modules/
prebuilds/
*.node
/tree-sitter-xquery.wasm
# Rebuilt fresh by .github/workflows/pages.yml on every deploy, from
# whatever tree-sitter-cli/web-tree-sitter versions package.json pins — a
# stale runtime paired with a freshly built grammar wasm can hard-fail to
# load (different wasm ABI/dynamic-linking format). The rest of docs/
# (playground shell) is checked in and static.
/docs/tree-sitter-xquery.wasm
/docs/web-tree-sitter.js
/docs/web-tree-sitter.wasm

# Scratch
temp/
tmp/
*.log
log.html
.DS_Store

# Local tooling — not part of the grammar
.claude/
.moderne/
.zed/
.codacy/
.cursor/
