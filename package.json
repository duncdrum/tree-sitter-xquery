{
  "name": "tree-sitter-xquery",
  "description": "XQuery tree-sitter",
  "version": "0.1.2",
  "author": "Grant Mackenzie <grantmacken@gmail.com>",
  "license": "MIT",
  "keywords": [
    "XQuery",
    "treesitter",
    "tree-sitter",
    "parser",
    "grammar",
    "tooling",
    "XML",
    "JSON"
  ],
  "homepage": "https://github.com/duncdrum/tree-sitter-xquery",
  "repository": {
    "type": "git",
    "url": "https://github.com/duncdrum/tree-sitter-xquery.git"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test": "tree-sitter test",
    "test:node": "node --test bindings/node/*_test.js",
    "test:queries": "node --test test/queries/*_test.js",
    "parse": "tree-sitter parse",
    "highlight": "tree-sitter query --captures queries/highlights.scm",
    "build": "yarn generate && node-gyp-build",
    "build-wasm": "tree-sitter build --wasm",
    "web": "tree-sitter playground",
    "tags": "tree-sitter tags"
  },
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prettier": "^2.8.7",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.0",
    "web-tree-sitter": "^0.27.0"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "bindings/node",
  "tree-sitter": [
    {
      "scope": "source.xquery",
      "file-types": [
        "xquery", "xqm", "xq", "xql"
      ]
    }
  ]
}
